from __future__ import annotations
import enum

__all__ = ["Encoder", "EncoderProgress", "EncoderState", "create_encoder", "dispatch_encoder",
           "encoder_output_name", "encoder_progress", "interrupt_encoder"]

class EncoderState(enum.Enum):
    READY = 0
    ACTIVE = 1
    DONE = 2
    FAILED = 3
    INTERRUPTED = 4

class EncoderProgress:
    @property
    def state(self) -> EncoderState: ...
    @property
    def fraction(self) -> float: ...
    @property
    def file(self) -> str: ...
    @property
    def error(self) -> str: ...
    @property
    def resident_bytes(self) -> int: ...
    @property
    def peak_resident_bytes(self) -> int: ...
    @property
    def memory_budget(self) -> int: ...

class Encoder: ...

def create_encoder(source: str, destination: str, quality: int = ..., subsampling: str = ...,
                   memory_budget: int = ..., concurrency: int = ..., layer_step: int = ...,
                   i2s_attributes: dict[str, str] = ..., i2s_version: int = ...) -> Encoder: ...
def dispatch_encoder(encoder: Encoder) -> None: ...
def encoder_progress(encoder: Encoder) -> EncoderProgress: ...
def interrupt_encoder(encoder: Encoder) -> None: ...
def encoder_output_name(source: str) -> str: ...
