{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 27,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vcpkg",
      "hidden": true,
      "description": "VcpkgCaches_16: the third-party libraries from vcpkg.json (cmake/toolchains/vcpkg.cmake)",
      "generator": "Ninja",
      "toolchainFile": "${sourceDir}/cmake/toolchains/vcpkg.cmake",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "FETCHCONTENT_UPDATES_DISCONNECTED": "ON"
      }
    },
    {
      "name": "release",
      "inherits": "vcpkg",
      "displayName": "Release: the library and the encoder",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug",
      "inherits": "vcpkg",
      "displayName": "Debug: the library, the encoder and the tests",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "IRIS_SLIDE_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "ci",
      "inherits": "vcpkg",
      "displayName": "CI: the library, the encoder and the tests, Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "IRIS_SLIDE_BUILD_TESTS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "jobs": 4,
      "description": "Four jobs: the 4-vCPU Blacksmith runners, a job count that fits the runner's memory"
    }
  ],
  "workflowPresets": [
    {
      "name": "release",
      "steps": [
        {
          "type": "configure",
          "name": "release"
        },
        {
          "type": "build",
          "name": "release"
        }
      ]
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "local"
        }
      }
    },
    {
      "name": "ci",
      "displayName": "CI: every test but the real-slide ones (CiRunsTests_1.5)",
      "configurePreset": "ci",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "exclude": {
          "label": "local"
        }
      }
    },
    {
      "name": "local",
      "displayName": "Local-slide parity tests (IRIS_SLIDE_TEST_SLIDES)",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "local"
        }
      }
    }
  ]
}
